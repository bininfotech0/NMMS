# Postgres / Prisma
POSTGRES_USER=nmms
POSTGRES_PASSWORD=nmms
POSTGRES_DB=nmms
DATABASE_URL=postgresql://nmms:nmms@localhost:5432/nmms?schema=public

# API
PORT=3000
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
FEATURE_FLAG_ENCRYPTION_KEY=change-me-feature-flag-encryption-key
AADHAAR_HASH_SECRET=change-me-aadhaar-hash-secret
CARD_QR_SECRET=change-me-card-qr-secret
# Member-portal login tokens — deliberately separate secrets from
# JWT_ACCESS_SECRET/JWT_REFRESH_SECRET so a member token can never be replayed
# against staff-only routes (and vice versa).
MEMBER_JWT_ACCESS_SECRET=change-me-member-access
MEMBER_JWT_REFRESH_SECRET=change-me-member-refresh

# Web
VITE_API_URL=http://localhost:3000
