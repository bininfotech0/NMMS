upstream api_upstream {
    server ${API_UPSTREAM};
}

upstream web_upstream {
    server ${WEB_UPSTREAM};
}

server {
    listen 80;

    # Above the API's raw upload ceiling (MAX_RAW_UPLOAD_BYTES in
    # apps/api/src/common/upload.util.ts, currently 10 MB — images get
    # compressed down to the app's real 2 MB stored limit after that), so an
    # oversized upload is rejected by the app (clear JSON 400) rather than
    # nginx's plain-HTML 413.
    client_max_body_size 11m;

    location /api/ {
        # The API serves everything under its own /api/v1 global prefix, so
        # the path is passed through as-is (no stripping/rewriting).
        proxy_pass http://api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Vite's dev-mode HMR client connects over a WebSocket; without these,
        # nginx serves it a plain 200 instead of upgrading, and hot-reload
        # silently falls back to full manual refreshes.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
